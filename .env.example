# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ipply?schema=public"

# Public base URL of the site (used for absolute links)
APP_URL="http://localhost:3000"

# Media storage: "local" (development; files in UPLOAD_DIR) or "s3" (any S3-compatible store)
STORAGE_DRIVER="local"
UPLOAD_DIR=".uploads"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (omit for AWS)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""     # public URL prefix that serves the bucket's objects

# Password for the seeded demonstration accounts (admin / creator / partner)
SEED_DEMO_PASSWORD="ipply-demo-2026"
